# Settings for docker-compose.yml. Copy and fill in:  cp .env.example .env
# .env is git-ignored, so secrets stay on your machine.

# Telegram bot token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat that receives alerts. Message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}. Groups start with -100. Required.
TELEGRAM_CHAT_ID=123456789
# Optional: forum topic (thread) inside the group. Enable Topics in group settings, open the topic,
# copy its link https://t.me/c/<chat>/<TOPIC_ID> and put the number here. Empty = General chat.
TELEGRAM_TOPIC_ID=
# Optional: separate chat for warning alerts (defaults to TELEGRAM_CHAT_ID). Warnings are sent silently.
TELEGRAM_WARNING_CHAT_ID=
# Optional: topic for warnings. Empty = TELEGRAM_TOPIC_ID when warnings go to the same group.
TELEGRAM_WARNING_TOPIC_ID=

# Public URLs used to build links inside alert messages.
# Change them when the stack runs on a server (e.g. https://grafana.example.com).
GRAFANA_URL=http://localhost:33000
PROMETHEUS_URL=http://localhost:39090
ALERTMANAGER_URL=http://localhost:39093
VMALERT_URL=http://localhost:38880

# Where Grafana listens on the host. GRAFANA_HOST: IP to bind (0.0.0.0 = every interface,
# 127.0.0.1 = this machine only, or one server IP). GRAFANA_PORT: main UI (themed proxy),
# GRAFANA_DIRECT_PORT: plain Grafana. Keep GRAFANA_URL above in sync with these.
GRAFANA_HOST=0.0.0.0
GRAFANA_PORT=33000
GRAFANA_DIRECT_PORT=33002

# Grafana login. Change the password before exposing Grafana to the internet.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional exporters (docker compose --profile <name> up -d). Leave empty when not used.
# PostgreSQL, profile "postgres". User needs the pg_monitor role. Leave commented out to watch the demo database.
# Set application_name in every app's connection string: the PostgreSQL dashboard groups by it.
POSTGRES_EXPORTER_DSN=postgresql://exporter:password@postgres:5432/postgres?sslmode=disable
# MySQL/MariaDB, profile "mysql". User needs PROCESS, REPLICATION CLIENT, SELECT.
# Defaults watch the demo database (user exporter / password exporter, created by mysql/init.sql).
MYSQL_EXPORTER_ADDRESS=mysql:3306
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=exporter
# Redis, profile "redis". Default watches the demo cache (service redis).
REDIS_EXPORTER_ADDR=redis://redis:6379
REDIS_EXPORTER_PASSWORD=
# MongoDB, profile "mongodb". User needs the clusterMonitor role (read-only).
MONGODB_EXPORTER_URI=mongodb://exporter:password@mongodb:27017/admin
# nginx stub_status page, profile "nginx". In nginx: location /stub_status { stub_status; }
NGINX_STUB_STATUS_URL=http://nginx:8080/stub_status

# Speedtest.net server id for speedtest-exporter. Empty = nearest server.
# List ids: docker compose exec speedtest-exporter speedtest --servers
SPEEDTEST_SERVER=
