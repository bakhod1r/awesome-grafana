# Settings for docker-compose.yml. Copy and fill in:  cp .env.example .env
# .env is git-ignored, so secrets stay on your machine.

# Telegram bot token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat that receives alerts. Message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}. Groups start with -100. Required.
TELEGRAM_CHAT_ID=123456789
# Optional: forum topic (thread) inside the group. Enable Topics in group settings, open the topic,
# copy its link https://t.me/c/<chat>/<TOPIC_ID> and put the number here. Empty = General chat.
TELEGRAM_TOPIC_ID=
# Optional: separate chat for warning alerts (defaults to TELEGRAM_CHAT_ID). Warnings are sent silently.
TELEGRAM_WARNING_CHAT_ID=
# Optional: topic for warnings. Empty = TELEGRAM_TOPIC_ID when warnings go to the same group.
TELEGRAM_WARNING_TOPIC_ID=
# Optional: one forum topic per alert category in TELEGRAM_CHAT_ID (critical loud, warning silent).
# Create the topics in the group and paste their ids. Empty = the critical / warning chat above.
TELEGRAM_TOPIC_SERVER=
TELEGRAM_TOPIC_CONTAINERS=
TELEGRAM_TOPIC_SITES=
TELEGRAM_TOPIC_DATABASE=
TELEGRAM_TOPIC_LOGS=
TELEGRAM_TOPIC_SRE=
TELEGRAM_TOPIC_DEPLOYS=
# Environment shown first in alert messages. Alerts from a container use its container.env label;
# server-wide alerts (CPU, disk, monitoring) use this, e.g. "dev,prod" when both run here.
# 🟥 when it includes prod, 🟦 otherwise. Empty = not shown for server-wide alerts.
ALERT_ENV=dev,prod
# Telegram usernames tagged on P1/P2 alerts (space separated). Empty = nobody is tagged.
TELEGRAM_MENTIONS=
# Optional per category, overrides TELEGRAM_MENTIONS for that topic (e.g. the DBA for database).
TELEGRAM_MENTIONS_SERVER=
TELEGRAM_MENTIONS_CONTAINERS=
TELEGRAM_MENTIONS_SITES=
TELEGRAM_MENTIONS_DATABASE=
TELEGRAM_MENTIONS_LOGS=
TELEGRAM_MENTIONS_SRE=

# Public URLs used to build links inside alert messages.
# Change them when the stack runs on a server (e.g. https://grafana.example.com).
GRAFANA_URL=http://localhost:33000
PROMETHEUS_URL=http://localhost:39090
ALERTMANAGER_URL=http://localhost:39093
VMALERT_URL=http://localhost:38880

# Where Grafana listens on the host. GRAFANA_HOST: IP to bind (0.0.0.0 = every interface,
# 127.0.0.1 = this machine only, or one server IP). GRAFANA_PORT: main UI (themed proxy),
# GRAFANA_DIRECT_PORT: plain Grafana. Keep GRAFANA_URL above in sync with these.
GRAFANA_HOST=0.0.0.0
GRAFANA_PORT=33000
GRAFANA_DIRECT_PORT=33002

# Grafana login. Change the password before exposing Grafana to the internet.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional exporters (docker compose --profile <name> up -d). Leave empty when not used.
# PostgreSQL, profile "postgres". User needs the pg_monitor role. Then switch on prometheus/exporters/postgres.yml.
# Set application_name in every app's connection string: the PostgreSQL dashboard groups by it.
# One DSN, or two separated by a comma (1st = postgres-exporter-1, 2nd = postgres-exporter-2).
# The exporters run in the host network: use 127.0.0.1:<port>, not "localhost". localhost may resolve to
# ::1 (IPv6), where a different PostgreSQL (installed on the host) can answer on the same port.
POSTGRES_EXPORTER_DSN=postgresql://exporter:password@127.0.0.1:5432/postgres?sslmode=disable
# Names of those servers, same order, shown in alerts and the dashboard (default db1,db2).
POSTGRES_EXPORTER_NAMES=prod,dev
# true = also collect top queries; needs the pg_stat_statements extension in the database(s).
POSTGRES_STAT_STATEMENTS=false
# Redis, profile "redis". Then switch on prometheus/exporters/redis.yml.
REDIS_EXPORTER_ADDR=redis://redis:6379
REDIS_EXPORTER_PASSWORD=
# MinIO (Storage dashboard). `make minio-token` builds the metrics token from these, tests it and
# writes prometheus/secrets/minio-token;
# the user needs the admin:Prometheus permission (root has it).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MinIO on this same server: host.docker.internal (its public name times out from inside Docker),
# then run `make firewall` once so Prometheus may reach MINIO_PORT.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
# Beyla (eBPF HTTP metrics, no app change): apps to watch, name=port or name=exe:port, comma-separated.
# e.g. BEYLA_SERVICES=api=8080,frontend=nginx:80
BEYLA_SERVICES=


# Websites probed from outside by blackbox (uptime, response time, SSL expiry; SiteDown alerts).
# SITES_<ENV>: URLs separated by commas; <ENV> becomes the env label (prod, dev).
SITES_PROJECT=
SITES_PROD=
SITES_DEV=
# e.g. SITES_PROD=https://app.example.com/,https://api.example.com/api

# Open ports check (port-watch). The server's public IP: every port listening on all interfaces is
# tried from here; one that answers and is not in ALLOWED_PUBLIC_PORTS fires PortExposed.
# Empty = detected automatically (AWS metadata, else ifconfig.me); "off" = only list ports, no check.
PUBLIC_IP=
ALLOWED_PUBLIC_PORTS=22,80,443
