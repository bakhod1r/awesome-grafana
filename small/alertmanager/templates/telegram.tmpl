{{/*
  Telegram message for Alertmanager (Go template, parse_mode: HTML).
  One block per alert in the group:
    icon + name + severity, summary, description, start/resolve time (TZ from docker-compose),
    links to Prometheus, the Grafana dashboard and a pre-filled silence.
  ${GRAFANA_URL} is filled in by entrypoint.sh. The dashboard uid comes from the rule's
  "dashboard" annotation (falls back to overview).

  Telegram rejects messages over 4096 characters, and Alertmanager cuts longer ones mid-tag, which
  breaks the HTML and fails the whole notification. So the message stays short on purpose:
    - at most 5 alerts in full, then a "showing 5 of N" line (all of them are in Grafana / Alertmanager)
    - summary and description cut to 300 characters
    - text from labels and annotations is HTML-escaped: a "<" in a log line would break parse_mode HTML
    - the Prometheus link points at the alerts page, not at the full query (a long query URL alone
      can take 1000+ characters)
*/}}
{{ define "telegram.cut" }}{{ reReplaceAll "(?s)^(.{300}).+$" "$1…" . | html }}{{ end }}
{{ define "telegram.message" }}
{{- range $i, $a := .Alerts }}{{ if lt $i 5 }}{{ with $a }}
{{- if eq .Status "firing" }}{{ if eq .Labels.severity "critical" }}🚨{{ else }}⚠️{{ end }}{{ else }}✅{{ end }} <b>{{ .Labels.alertname | html }}</b> [{{ .Labels.severity | html }}]
{{ template "telegram.cut" .Annotations.summary }}
{{ template "telegram.cut" .Annotations.description }}
{{- /* container.* labels: cadvisor alerts carry container_label_container_*, log alerts team/env/type. */}}
{{- $team := or .Labels.team (index .Labels "container_label_container_team") }}
{{- $env := or .Labels.env (index .Labels "container_label_container_env") }}
{{- $type := or .Labels.type (index .Labels "container_label_container_type") }}
{{- if or $team $env $type }}
👥 {{ if $team }}Team: {{ $team | html }}{{ end }}{{ if $env }}{{ if $team }} · {{ end }}Env: {{ $env | html }}{{ end }}{{ if $type }}{{ if or $team $env }} · {{ end }}Type: {{ $type | html }}{{ end }}
{{- end }}
🕒 Started: {{ .StartsAt.Local.Format "2006-01-02 15:04:05 MST" }}
{{- if eq .Status "resolved" }}
🕒 Resolved: {{ .EndsAt.Local.Format "2006-01-02 15:04:05 MST" }}
{{- end }}
{{- /* Logs link: log alerts carry "container", cadvisor alerts carry "name". Opens the Logs dashboard
       filtered to that container for the last hour. Omitted for alerts without a container. */}}
{{- $c := or .Labels.container .Labels.name }}
🔗 <a href="{{ reReplaceAll "/graph\\?.*$" "/alerts" .GeneratorURL }}">Prometheus</a> | <a href="${GRAFANA_URL}/d/{{ or .Annotations.dashboard "overview" }}">Dashboard</a>
{{- if $c }} | <a href="${GRAFANA_URL}/d/logs?var-container={{ $c | urlquery }}&amp;from=now-1h&amp;to=now">Logs</a>{{ end }}
{{- if eq .Status "firing" }} | <a href="{{ $.ExternalURL }}/#/silences/new?filter={{ printf "{alertname=\"%s\"}" .Labels.alertname | urlquery }}">Silence</a>{{ end }}

{{ end }}{{ end }}{{ end }}
{{- if gt (len .Alerts) 5 }}… showing 5 of {{ len .Alerts }} alerts. All of them: <a href="${GRAFANA_URL}/d/alerts">Alerts dashboard</a>
{{ end }}
{{- end }}
