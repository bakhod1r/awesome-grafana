{{/*
  Telegram message for Alertmanager (Go template, parse_mode: HTML). One block per alert:

    🟥 PROD · 🔴 P1 · FIRING                       environment (container.env, else ALERT_ENV), priority, status: readable in the notification preview
    🐘 PostgreSQL unreachable: db:5432             summary (bold): what is wrong, in plain words
    🔔 PostgresDown · Database                     alert name and category (italic): what to search for
    📝 postgres-exporter cannot connect.           description: impact / what to check
    🖥️ db:5432 · 📦 api · 👥 backend               where: instance, container, team
    🕒 2026-10-27 12:00 +05                        start (and end + duration when resolved)
    📊 Dashboard · 📜 Logs · 🔕 Silence
    📣 @user1 @user2                               only P1/P2 while firing

  ${GRAFANA_URL}, ${ALERT_ENV} and ${TELEGRAM_MENTIONS_*} are filled in by entrypoint.sh.
  Annotations used: summary, description, dashboard (Grafana uid, default overview).

  Telegram rejects messages over 4096 characters, and Alertmanager cuts longer ones mid-tag, which
  breaks the HTML and fails the whole notification. So the message stays short on purpose:
    - at most 5 alerts in full, then a "showing 5 of N" line (all of them are in Grafana / Alertmanager)
    - summary and description cut to 300 characters
    - text from labels and annotations is HTML-escaped: a "<" in a log line would break parse_mode HTML
*/}}
{{ define "telegram.cut" }}{{ reReplaceAll "(?s)^(.{300}).+$" "$1…" . | html }}{{ end }}

{{/* Icon from the alert name: finer than the topic (category label), e.g. SLO vs proxy inside Sites. */}}
{{ define "telegram.icon" }}
{{- if eq . "ContainerUpdated" }}🚀
{{- else if match "^Postgres" . }}🐘
{{- else if match "^(Nginx|Proxy)" . }}🔀
{{- else if match "^Container" . }}📦
{{- else if match "^(Site|Ssl|Probe)" . }}🌐
{{- else if match "^(Slo|App.*Budget)" . }}🎯
{{- else if match "^(DiskSmart|DiskTemperature|SsdWear|Speedtest)" . }}🔧
{{- else if match "^(Tempo|VectorTrace)" . }}🧵
{{- else if match "^(Vector|LogsNotIngested|LogSilence|VmalertRule)" . }}🚰
{{- else if match "^Log" . }}📜
{{- else if match "^(Watchdog|Prometheus|RuleEvaluation|VmalertNotifier|Alert|Monitoring|Cardinality|VictoriaMetrics)" . }}🛡️
{{- else if match "^Port" . }}🔓
{{- else if match "^Test" . }}🧪
{{- else }}🖥️{{ end }}
{{- end }}

{{ define "telegram.priority" }}
{{- if eq . "P1" }}🔴 <b>P1</b>{{ else if eq . "P2" }}🟠 <b>P2</b>{{ else if eq . "P3" }}🟡 <b>P3</b>{{ else if eq . "info" }}ℹ️ <b>info</b>{{ else }}<b>{{ . | html }}</b>{{ end }}
{{- end }}

{{ define "telegram.message" }}
{{- range $i, $a := .Alerts }}{{ if lt $i 5 }}{{ with $a }}
{{- $p := or .Labels.priority .Labels.severity }}
{{- /* Line 1: environment · priority · status. */}}
{{- /* Environment of this alert: the container's env label (container.env), else ALERT_ENV for the whole
       server (e.g. "dev,prod" when both run here). Red when it includes prod. */}}
{{- $where := or .Labels.env (index .Labels "container_label_container_env") "${ALERT_ENV}" }}
{{- with $where }}{{ if match "(?i)prod" . }}🟥{{ else }}🟦{{ end }} <b><i>{{ toUpper . | html }}</i></b> · {{ end }}
{{- if eq .Status "firing" }}{{ template "telegram.priority" $p }} · <b><i>FIRING</i></b>
{{- else }}✅ <b><i>RESOLVED</i></b> · {{ template "telegram.priority" $p }}{{ end }}
{{ template "telegram.icon" .Labels.alertname }} <b>{{ if .Annotations.summary }}{{ template "telegram.cut" .Annotations.summary }}{{ else }}{{ .Labels.alertname | html }}{{ end }}</b>
🔔 <b><i>{{ .Labels.alertname | html }}{{ with .Labels.category }} · {{ title . | html }}{{ end }}</i></b>
{{- if eq .Status "firing" }}{{ with .Annotations.description }}
📝 <i>{{ template "telegram.cut" . }}</i>{{ end }}{{ end }}
{{- /* Where: host, container and the container.* labels (cadvisor: container_label_container_*, logs: team/env/type). */}}
{{- $c := or .Labels.container .Labels.name }}
{{- $team := or .Labels.team (index .Labels "container_label_container_team") }}
{{- if or .Labels.instance $c $team }}
{{- $s := "" }}
{{ with .Labels.instance }}🖥️ <b><code>{{ . | html }}</code></b>{{ $s = " · " }}{{ end }}
{{- with $c }}{{ $s }}📦 <b><code>{{ . | html }}</code></b>{{ $s = " · " }}{{ end }}
{{- with $team }}{{ $s }}👥 <b><i>{{ . | html }}</i></b>{{ end }}
{{- end }}
{{- if eq .Status "firing" }}
🕒 <b><i>{{ .StartsAt.Local.Format "2006-01-02 15:04 MST" }}</i></b>
{{- else }}
🕒 <b><i>{{ .StartsAt.Local.Format "2006-01-02 15:04" }} → {{ .EndsAt.Local.Format "15:04 MST" }}</i></b> · ⌛ <b><i>{{ reReplaceAll "m0s$" "m" ((.EndsAt.Sub .StartsAt).Round 60000000000).String }}</i></b>
{{- end }}
{{- /* Logs: last hour of that container. Silence: only while firing. */}}
📊 <a href="${GRAFANA_URL}/d/{{ or .Annotations.dashboard "overview" }}"><b><i>Dashboard</i></b></a>
{{- if $c }} · 📜 <a href="${GRAFANA_URL}/d/logs?var-container={{ $c | urlquery }}&amp;from=now-1h&amp;to=now"><b><i>Logs</i></b></a>{{ end }}
{{- if eq .Status "firing" }} · 🔕 <a href="{{ $.ExternalURL }}/#/silences/new?filter={{ printf "{alertname=\"%s\"}" .Labels.alertname | urlquery }}"><b><i>Silence</i></b></a>{{ end }}
{{- /* Tag on-call on P1/P2 while firing: TELEGRAM_MENTIONS_<CATEGORY> (entrypoint.sh defaults it to TELEGRAM_MENTIONS). */}}
{{- if and (eq .Status "firing") (or (eq $p "P1") (eq $p "P2")) }}
{{- $m := "${TELEGRAM_MENTIONS}" }}
{{- if eq .Labels.category "server" }}{{ $m = "${TELEGRAM_MENTIONS_SERVER}" }}
{{- else if eq .Labels.category "containers" }}{{ $m = "${TELEGRAM_MENTIONS_CONTAINERS}" }}
{{- else if eq .Labels.category "sites" }}{{ $m = "${TELEGRAM_MENTIONS_SITES}" }}
{{- else if eq .Labels.category "database" }}{{ $m = "${TELEGRAM_MENTIONS_DATABASE}" }}
{{- else if eq .Labels.category "logs" }}{{ $m = "${TELEGRAM_MENTIONS_LOGS}" }}
{{- else if eq .Labels.category "sre" }}{{ $m = "${TELEGRAM_MENTIONS_SRE}" }}{{ end }}
{{- with trimSpace $m }}
📣 <b><i>{{ . | html }}</i></b>{{ end }}{{ end }}

{{ end }}{{ end }}{{ end }}
{{- if gt (len .Alerts) 5 }}<i>… showing 5 of {{ len .Alerts }} alerts.</i> All of them: <a href="${GRAFANA_URL}/d/alerts">Alerts dashboard</a>
{{ end }}
{{- end }}
