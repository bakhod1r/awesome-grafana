// Grafana Alloy: pulls pprof profiles from Go services and pushes them to Pyroscope.
// Logs and OTLP are handled by Vector (vector/vector.yaml); Vector has no pprof support, so this
// small Alloy stays for profiles only.
// Live view of this pipeline: http://localhost:12345

// Profiles (continuous profiling) → Pyroscope. Go services serve pprof on /debug/pprof;
//    Alloy pulls CPU, memory, goroutine, mutex and block profiles from them every 15s and pushes
//    them to Pyroscope. Grafana shows them under Explore → Profiles and on the "Profiles" dashboard,
//    and a Tempo span opens the profile of the same service and time (tracesToProfiles).
//    Your own Go app: add a target below with its service_name (net/http/pprof must be imported),
//    or push from the app with a Pyroscope SDK to http://pyroscope:4040 (any language).
pyroscope.scrape "stack" {  // component: pull pprof profiles
  targets = [
    {"__address__" = "localhost:12345",      "service_name" = "alloy"},
    {"__address__" = "prometheus:9090",      "service_name" = "prometheus"},
    {"__address__" = "alertmanager:9093",    "service_name" = "alertmanager"},
    {"__address__" = "tempo:3200",           "service_name" = "tempo"},
    // {"__address__" = "my-app:8080", "service_name" = "my-app"},  // your Go app with net/http/pprof
  ]
  scrape_interval = "15s"  // CPU profile covers the whole interval, so this is also its length
  forward_to      = [pyroscope.write.default.receiver]  // output: push to Pyroscope
}

// VictoriaMetrics components serve only CPU, heap and goroutine profiles: asking for mutex/block
// returns an error every 15s, so those two are switched off here.
pyroscope.scrape "victoria" {  // component: pull pprof profiles
  targets = [
    {"__address__" = "victoriametrics:8428", "service_name" = "victoriametrics"},
    {"__address__" = "victorialogs:9428",    "service_name" = "victorialogs"},
    {"__address__" = "vmalert:8880",         "service_name" = "vmalert"},
  ]
  profiling_config {  // which pprof endpoints to pull
    profile.mutex { enabled = false }  // not served by VictoriaMetrics
    profile.block { enabled = false }  // not served by VictoriaMetrics
  }
  scrape_interval = "15s"  // same as above
  forward_to      = [pyroscope.write.default.receiver]  // output: push to Pyroscope
}

pyroscope.write "default" {  // component: push profiles
  endpoint {  // push target
    url = "http://pyroscope:4040"  // Pyroscope ingest API
  }
}
