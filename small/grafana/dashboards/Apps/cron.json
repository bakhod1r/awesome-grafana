{
  "title": "Cron",
  "uid": "cron",
  "description": "Scheduled and batch jobs: last run, last success, duration, exit code — pushed to the Pushgateway by the job itself. Push cron_job_last_run_timestamp_seconds, cron_job_last_success_timestamp_seconds (on success), cron_job_duration_seconds and cron_job_exit_code to http://pushgateway:9091/metrics/job/<name>/instance/<host>.",
  "tags": [
    "cron",
    "jobs",
    "services"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Node",
      "type": "link",
