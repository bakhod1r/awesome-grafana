  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Critical alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=\"critical\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}} {{name}} {{service}}"
      },
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "textbox",
        "query": ".*",
        "hide": 2,
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"apps\", project=~\"$project\"}, container)",
          "refId": "container"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "description": "Container scraped by the discoverer (job apps).",
        "hide": 0,
        "allowCustomValue": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - process_start_time_seconds{container=~\"$container\", container!=\"\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "links": []
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
