{
  "title": "Runtime: Go",
  "uid": "runtime-go",
  "description": "Go runtime of containers labelled container.lang=go. Go client (prometheus/client_golang) default metrics.",
  "tags": [
    "runtime",
    "go",
    "services"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
