    {
      "type": "stat",
      "title": "Running",
      "description": "JavaScript containers seen by cAdvisor in the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - container_last_seen{name=~\"$container\", name!=\"\", container_label_container_lang=\"javascript\"} < 60) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
