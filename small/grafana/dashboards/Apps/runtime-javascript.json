{
  "title": "Runtime: JavaScript",
  "uid": "runtime-javascript",
  "description": "JavaScript frontends (container.lang=javascript): static bundles served by nginx. No runtime metrics exist, so: container health, traffic from access logs, and logs.",
  "tags": [
    "runtime",
    "javascript",
    "frontend",
    "services"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
