    {
      "type": "stat",
      "title": "Health",
      "description": "GREEN all shards placed. YELLOW replicas missing (normal on one node). RED a primary shard is missing: data unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(elasticsearch_cluster_health_status{project=~\"$project\", color=\"green\"}) * 2 + max(elasticsearch_cluster_health_status{project=~\"$project\", color=\"yellow\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "RED",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "YELLOW",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "GREEN",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "links": []
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 4
      }
