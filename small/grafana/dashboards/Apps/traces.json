{
  "uid": "traces",
  "title": "Traces",
  "tags": [
    "traces",
    "tempo",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "S"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "allowCustomValue": false
      },
      {
        "name": "status",
        "label": "HTTP status",
        "type": "custom",
        "query": "2..,3..,4..,5..,200,201,204,301,302,400,401,403,404,409,422,429,500,502,503,504",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])), \"service\", \"(none)\", \"service\", \"\")",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No failed server spans"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / (sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) > 0), \"service\", \"(none)\", \"service\", \"\")",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))), \"service\", \"(none)\", \"service\", \"\")",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest operations (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (service, span_name, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__rate_interval]))))",
          "legendFormat": "{{service}} {{span_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "nodeGraph",
      "title": "Service graph",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent failed traces (click a trace id)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && status = error }",
          "limit": 20
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent slow traces > 1s",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && duration > 1s }",
          "limit": 20
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Responses by HTTP status (200 / 400 / 500 ...)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Server spans per second split by http.response.status_code. Needs the http.response.status_code dimension in tempo/tempo.yaml and an app that sets it.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "2.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "4.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(sum by (http_response_status_code) (rate(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__rate_interval])), \"http_response_status_code\", \"(none)\", \"http_response_status_code\", \"\")",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p95 latency by route (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (service, http_route, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__rate_interval]))))",
          "legendFormat": "{{service}} {{http_route}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Routes over the selected time range (slowest p95 first)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "4xx %"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.05
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "5xx %"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.01
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service, http_route) (increase(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service, http_route) (increase(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\",http_response_status_code=~\"4..\"}[$__range])) / sum by (service, http_route) (increase(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (service, http_route) (increase(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\",http_response_status_code=~\"5..\"}[$__range])) / sum by (service, http_route) (increase(traces_spanmetrics_calls_total{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (service, http_route, le) (increase(traces_spanmetrics_latency_bucket{service=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"$status\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Related",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "traces"
      ],
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/services/services?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/postgres/postgresql?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/logs/logs?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "icon": "bolt",
      "url": "/d/alerts/alerts?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/probes-slo/probes-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "App SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/app-slo/app-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Stack",
      "type": "link",
      "icon": "cloud",
      "url": "/d/self/self?${__url_time_range}",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
