        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(container_memory_working_set_bytes{name=~\"$container\", name!=\"\", container_label_container_type=~\"worker\"} / (container_spec_memory_limit_bytes{name=~\"$container\", name!=\"\", container_label_container_type=~\"worker\"} > 0)) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
