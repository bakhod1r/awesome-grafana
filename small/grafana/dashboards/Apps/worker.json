    {
      "type": "stat",
      "title": "Failed %",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(asynq_tasks_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(celery_task_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(sidekiq_jobs_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(bullmq_job_count{container=~\"$container\", state=\"failed\"}[5m])))) / (((sum(rate(asynq_tasks_processed_total{container=~\"$container\"}[5m]))) or (sum(rate(celery_task_succeeded_total{container=~\"$container\"}[5m]))) or (sum(rate(sidekiq_jobs_executed_total{container=~\"$container\"}[5m]))) or (sum(rate(bullmq_job_count{container=~\"$container\", state=\"completed\"}[5m])))) + ((sum(rate(asynq_tasks_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(celery_task_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(sidekiq_jobs_failed_total{container=~\"$container\"}[5m]))) or (sum(rate(bullmq_job_count{container=~\"$container\", state=\"failed\"}[5m]))))) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "links": [],
          "decimals": 1,
          "noValue": "No job metrics"
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "x": 4,
        "y": 6,
        "w": 4,
        "h": 4
      }
