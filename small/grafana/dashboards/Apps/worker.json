          "refId": "A",
          "expr": "sum(resets(container_cpu_usage_seconds_total{name=~\"$container\", name!=\"\", container_label_container_type=~\"worker\"}[24h])) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
