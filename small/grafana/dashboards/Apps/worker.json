      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(asynq_tasks_processed_total{container=~\"$container\"}[5m]))) or (sum(rate(celery_task_succeeded_total{container=~\"$container\"}[5m]))) or (sum(rate(sidekiq_jobs_executed_total{container=~\"$container\"}[5m]))) or (sum(rate(bullmq_job_count{container=~\"$container\", state=\"completed\"}[5m])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
