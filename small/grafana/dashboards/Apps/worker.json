      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(container_oom_events_total{name=~\"$container\", name!=\"\", container_label_container_type=~\"worker\"}[24h])) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
