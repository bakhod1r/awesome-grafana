{
  "title": "Container",
  "uid": "container",
  "description": "One container: status, restarts, CPU, memory against its limit, network, disk, logs by level, top errors, and API latency from request logs when the app writes them.",
  "tags": [
    "docker",
    "container"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Node",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/node-overview/node-overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
