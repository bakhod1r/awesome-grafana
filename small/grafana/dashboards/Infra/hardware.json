{
  "title": "Hardware & Internet",
  "uid": "hardware",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Scrutiny (SMART failure prediction)",
      "url": "http://localhost:8081",
      "targetBlank": true,
      "type": "link"
    },
    {
      "title": "Related",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "hardware"
      ],
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Node",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/node-overview/node-overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/services/services?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/postgres/postgresql?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/logs/logs?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Traces",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/traces/traces?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "icon": "bolt",
      "url": "/d/alerts/alerts?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/probes-slo/probes-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "App SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/app-slo/app-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Stack",
      "type": "link",
      "icon": "cloud",
      "url": "/d/self/self?${__url_time_range}",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Internet speed (speedtest-exporter, one test every 30m)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Download",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20000000.0
              },
              {
                "color": "green",
                "value": 50000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(speedtest_download_bits_per_second[1h])",
          "legendFormat": "download"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Upload",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000000.0
              },
              {
                "color": "green",
                "value": 30000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(speedtest_upload_bits_per_second[1h])",
          "legendFormat": "upload"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Ping",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(speedtest_ping_latency_milliseconds[1h])",
          "legendFormat": "ping"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Speed history",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": 3600000,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "speedtest_download_bits_per_second",
          "legendFormat": "download"
        },
        {
          "expr": "speedtest_upload_bits_per_second",
          "legendFormat": "upload"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ping and jitter",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineInterpolation": "stepAfter",
            "spanNulls": 3600000,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "speedtest_ping_latency_milliseconds",
          "legendFormat": "ping"
        },
        {
          "expr": "speedtest_jitter_latency_milliseconds",
          "legendFormat": "jitter"
        }
      ]
    },
    {
      "type": "row",
      "title": "Disks (smartctl-exporter, profile \"smart\", Linux only)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Drive temperature",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "max": 70,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 55
              }
            ]
          },
          "noValue": "No SMART data (profile \"smart\", Linux only)"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_temperature{temperature_type=\"current\"}",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      }
    },
    {
      "type": "stat",
      "title": "SMART status",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "PASSED",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_smart_status",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "The disk's own pass/fail self-assessment. FAILED = back up and replace. Empty: No SMART data (profile \"smart\", Linux only)"
    },
    {
      "type": "bargauge",
      "title": "SSD wear (% of rated endurance used)",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No SMART data (profile \"smart\", Linux only)"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "smartctl_device_percentage_used",
          "legendFormat": "{{device}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true
      },
      "description": "NVMe/SATA SSDs only. Failure probability per disk: Scrutiny UI at http://localhost:8081"
    },
    {
      "type": "timeseries",
      "title": "Drive temperature history",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No SMART data (profile \"smart\", Linux only)"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(smartctl_device_temperature{temperature_type=\"current\"}, \"device\", \"(none)\", \"device\", \"\")",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Drives",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Power-on hours"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "smartctl_device_power_on_seconds / 3600",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "device": "Device",
              "model_name": "Model",
              "serial_number": "Serial",
              "capacity_bytes": "Capacity",
              "Value #B": "Power-on hours"
            }
          }
        }
      ],
      "description": "Empty: No SMART data (profile \"smart\", Linux only)"
    }
  ],
  "tags": [
    "hardware",
    "smart",
    "disk",
    "internet",
    "speedtest"
  ],
  "annotations": {
    "list": [
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
