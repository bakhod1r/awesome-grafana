{
  "title": "Node Overview",
  "uid": "node-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU %",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "label_replace(instance:node_cpu_utilisation:percent, \"instance\", \"(none)\", \"instance\", \"\")",
          "legendFormat": "{{instance}}"
        }
      ],
      "links": [
        {
          "title": "Logs (same time range)",
          "url": "/d/logs?${__url_time_range}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "label_replace(instance:node_memory_used:bytes, \"instance\", \"(none)\", \"instance\", \"\")",
          "legendFormat": "{{instance}}"
        }
      ],
      "links": [
        {
          "title": "Logs (same time range)",
          "url": "/d/logs?${__url_time_range}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Disk used %",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        }
      },
      "targets": [
        {
          "expr": "instance:node_filesystem_root_used:percent"
        }
      ],
      "links": [
        {
          "title": "Logs (same time range)",
          "url": "/d/logs?${__url_time_range}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network rx/tx",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "expr": "sum(instance:node_network_receive_bytes:rate1m)",
          "legendFormat": "rx"
        },
        {
          "expr": "sum(instance:node_network_transmit_bytes:rate1m)",
          "legendFormat": "tx"
        }
      ],
      "links": [
        {
          "title": "Logs (same time range)",
          "url": "/d/logs?${__url_time_range}"
        }
      ]
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Disk full in (forecast)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Hours until each real filesystem is full at the pace of the last 6 hours. Only filesystems that are filling up are shown; 'Not filling up' = free space is stable or growing. Alerts: DiskWillFillIn24h (warning), DiskWillFillIn4h (critical).",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min by (instance, device) (device:node_filesystem_full_in:hours)",
          "legendFormat": "{{device}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 0,
          "noValue": "Not filling up",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "yellow",
                "value": 24
              },
              {
                "color": "green",
                "value": 168
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Free space and 24h forecast",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Solid: free space now. Dashed: where predict_linear (6h trend) says it will be in 24 hours. Dashed line reaching 0 = DiskWillFillIn24h.",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|erofs|squashfs|fakeowner|nsfs|ramfs|devtmpfs|fuse.*\", mountpoint!~\"/etc/.+|/oldroot.*|/host_mnt.*|/run.*|/boot.*\"})",
          "legendFormat": "{{device}} free"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (device) (predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|erofs|squashfs|fakeowner|nsfs|ramfs|devtmpfs|fuse.*\", mountpoint!~\"/etc/.+|/oldroot.*|/host_mnt.*|/run.*|/boot.*\"}[6h], 24 * 3600))",
          "legendFormat": "{{device}} in 24h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* in 24h"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "tags": [
    "node",
    "host",
    "node-exporter",
    "cpu",
    "memory"
  ],
  "links": [
    {
      "title": "Related",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "node"
      ],
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/services/services?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/postgres/postgresql?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/logs/logs?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Traces",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/traces/traces?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "icon": "bolt",
      "url": "/d/alerts/alerts?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/probes-slo/probes-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "App SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/app-slo/app-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Profiles",
      "type": "link",
      "icon": "fire",
      "url": "/d/profiles/profiles?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Stack",
      "type": "link",
      "icon": "cloud",
      "url": "/d/self/self?${__url_time_range}",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
