{
  "title": "App SLO",
  "uid": "app-slo",
  "description": "Service level objectives for your apps (job apps): availability 99.5% of requests are not 5xx, latency 99.0% of requests finish within 1s, over a rolling 30 days. Error budget = how many bad requests are still allowed; burn rate = how fast it is being used (1x = exactly used up in 30 days). Alerts: AppErrorBudget*/AppLatencyBudget* (fast burn 14.4x critical, slow burn 6x warning).",
  "tags": [
    "slo",
    "apps",
    "error-budget",
    "burn-rate",
    "endpoints"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Probes & SLO (blackbox)",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/probes-slo/probes-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
