    {
      "type": "timeseries",
      "title": "Error burn rate",
      "description": "1x = budget lasts exactly 30 days. Fast-burn alert: 1h and 5m above 14.4x. Slow-burn: 6h and 30m above 6x.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:app_request_errors:ratio_rate1h{service=~\"$service\"} / 0.005",
          "legendFormat": "{{service}} 1h",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "service:app_request_errors:ratio_rate6h{service=~\"$service\"} / 0.005",
          "legendFormat": "{{service}} 6h",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
