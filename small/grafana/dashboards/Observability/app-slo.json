  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Critical alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=\"critical\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}} {{name}} {{service}}"
      },
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(service:app_requests:rate5m, service)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "description": "Services of job apps with traffic.",
        "hide": 0,
        "allowCustomValue": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "All services — 30 days",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "**Availability SLO 99.5%** → budget 0.5% of requests may fail (5xx). **Latency SLO 99.0%** → budget 1% may take over 1s.  \n**Budget left** 100% = untouched, 0% = used up (stop risky deploys, fix reliability first). **Burn 1h** above 14.4x pages, above 6x over 6h warns. Click a service name to filter, or jump to its endpoints."
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "table",
      "title": "SLO per service",
      "description": "Empty: No app traffic: job apps has no http_requests_total yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (sum by (service) (increase(http_requests_total{job=\"apps\", service=~\"$service\", status=~\"5..\"}[30d])) / sum by (service) (increase(http_requests_total{job=\"apps\", service=~\"$service\"}[30d])))) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(1 - (sum by (service) (increase(http_requests_total{job=\"apps\", service=~\"$service\", status=~\"5..\"}[30d])) / sum by (service) (increase(http_requests_total{job=\"apps\", service=~\"$service\"}[30d]))) / 0.005) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "service:app_request_errors:ratio_rate1h{service=~\"$service\"} / 0.005",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "(1 - (1 - sum by (service) (increase(http_request_duration_seconds_bucket{job=\"apps\", service=~\"$service\", le=\"1\"}[30d])) / sum by (service) (increase(http_request_duration_seconds_count{job=\"apps\", service=~\"$service\"}[30d])))) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "(1 - (1 - sum by (service) (increase(http_request_duration_seconds_bucket{job=\"apps\", service=~\"$service\", le=\"1\"}[30d])) / sum by (service) (increase(http_request_duration_seconds_count{job=\"apps\", service=~\"$service\"}[30d]))) / 0.01) * 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "service:app_request_slow:ratio_rate1h{service=~\"$service\"} / 0.01",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "service:app_requests:rate5m{service=~\"$service\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "server": true
            },
            "renameByName": {
              "Value #A": "Availability 30d",
              "Value #B": "Error budget left",
              "Value #C": "Error burn 1h",
              "Value #D": "Within 1s 30d",
              "Value #E": "Latency budget left",
              "Value #F": "Latency burn 1h",
              "Value #G": "Req/s"
            },
            "indexByName": {
              "service": 0,
              "Availability 30d": 1,
              "Error budget left": 2,
              "Error burn 1h": 3,
              "Within 1s 30d": 4,
              "Latency budget left": 5,
              "Latency burn 1h": 6,
              "Req/s": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": [],
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Only this service",
                    "url": "/d/app-slo/app-slo?${__url_time_range}&var-service=${__data.fields.service}"
                  },
                  {
                    "title": "Endpoints of this service",
                    "url": "/d/endpoints/app-endpoints?${__url_time_range}&var-service=${__data.fields.service}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Availability 30d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Within 1s 30d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*budget left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 25
                    },
                    {
                      "color": "green",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*burn 1h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "x"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 6
                    },
                    {
                      "color": "red",
                      "value": 14.4
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
