{
  "title": "Profiles",
  "uid": "profiles",
  "description": "Continuous profiling (Pyroscope): where each service spends CPU and memory, down to the function. Pick a service; compare time ranges to find what changed after a deploy. From a trace in Tempo, 'Profiles for this span' opens the same view.",
  "tags": [
    "profiles",
    "pyroscope",
    "performance",
    "cpu",
    "memory"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Explore profiles",
      "type": "link",
      "icon": "external link",
      "url": "/a/grafana-pyroscope-app/explore",
      "targetBlank": false
    },
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Node",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/node-overview/node-overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/services/services?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/postgres/postgresql?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/logs/logs?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Traces",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/traces/traces?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "icon": "bolt",
      "url": "/d/alerts/alerts?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/probes-slo/probes-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "App SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/app-slo/app-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Stack",
      "type": "link",
      "icon": "cloud",
      "url": "/d/self/self?${__url_time_range}",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Critical alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=\"critical\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}} {{name}} {{service}}"
      },
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "pyroscope"
        },
        "query": {
          "type": "labelValue",
          "labelName": "service_name",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "description": "service_name in Pyroscope. Stack services are pulled by Alloy (alloy/config.alloy).",
        "allowCustomValue": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU time per second",
      "description": "CPU nanoseconds per second spent by the service (1e9 = one full core).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [
            "service_name"
          ],
          "spanSelector": [],
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Memory in use",
      "description": "Heap in use at each sample (Go: inuse_space).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [
            "service_name"
          ],
          "spanSelector": [],
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "description": "Goroutine count. A line that only goes up is a goroutine leak.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "goroutine:goroutine:count:goroutine:count",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [
            "service_name"
          ],
          "spanSelector": [],
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "row",
      "id": 5,
      "title": "Flame graphs — wider bar = more cost; click a frame to zoom",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "flamegraph",
      "title": "CPU",
      "description": "Total CPU time per function over the selected range. Look for wide bars near the bottom: that code runs most.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 14
      }
    },
    {
      "type": "flamegraph",
      "title": "Memory allocations",
      "description": "Bytes allocated per function. Heavy allocators drive GC CPU time.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "memory:alloc_space:bytes:space:bytes",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 14
      }
    },
    {
      "type": "flamegraph",
      "title": "Memory in use",
      "description": "Live heap per function at the end of the range: where memory is held.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=~\"$service\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {},
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 14
      }
    }
  ]
}
