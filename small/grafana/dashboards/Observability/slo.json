{
  "title": "Probes & SLO",
  "uid": "probes-slo",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Every blackbox probe (HTTP, TCP, TLS, ICMP, DNS), certificate expiry, 30-day availability and error budget.",
  "templating": {
    "list": [
      {
        "name": "slo",
        "label": "SLO target %",
        "type": "custom",
        "query": "99,99.5,99.9,99.95,99.99",
        "current": {
          "text": "99.9",
          "value": "99.9"
        },
        "description": "Availability objective. Alerts (SloFastBurn/SloSlowBurn) use 99.9; keep in sync with prometheus/rules/alerts.yml."
      },
      {
        "name": "job",
        "label": "Probe type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(probe_success, job)",
          "refId": "q"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allowCustomValue": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Probe status",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"$job\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(probe_duration_seconds{job=~\"$job\"}, \"instance\", \"(none)\", \"instance\", \"\")",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Days until certificate expires",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort((probe_ssl_earliest_cert_expiry{job=~\"$job\"} - time()) / 86400)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          }
        }
      },
      "description": "HTTPS and TLS probes only. Warning under 14 days, critical under 3.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "type": "row",
      "title": "SLO (30 days, from VictoriaMetrics)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Availability and error budget, last 30 days",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(job_instance:probe_success:avg5m{job=~\"$job\"}[30d]) * 100",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(1 - (1 - avg_over_time(job_instance:probe_success:avg5m{job=~\"$job\"}[30d])) / (1 - $slo / 100)) * 100",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(1 - avg_over_time(job_instance:probe_success:avg5m{job=~\"$job\"}[30d])) * 30 * 24 * 60",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Budget left %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Downtime (min)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "description": "Availability = share of successful probes. Budget left = how much of the allowed failure (100 - SLO) is still unused; below 0 = SLO missed. Needs the recording rule job_instance:probe_success:avg5m, so history starts when it was added.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "Availability %",
              "Value #B": "Budget left %",
              "Value #C": "Downtime (min)",
              "job": "Type",
              "instance": "Target"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error budget remaining (rolling 30d)",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace((1 - (1 - avg_over_time(job_instance:probe_success:avg5m{job=~\"$job\"}[30d])) / (1 - $slo / 100)) * 100, \"instance\", \"(none)\", \"instance\", \"\")",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate (1h)",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace((1 - avg_over_time(probe_success{job=~\"$job\"}[1h])) / (1 - $slo / 100), \"instance\", \"(none)\", \"instance\", \"\")",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "description": "1 = budget lasts exactly 30 days. 6 and 14.4 are the SloSlowBurn/SloFastBurn thresholds."
    }
  ],
  "tags": [
    "slo",
    "probes",
    "blackbox",
    "uptime"
  ],
  "links": [
    {
      "title": "Related",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "slo"
      ],
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Home",
      "type": "link",
      "icon": "apps",
      "url": "/d/overview/overview?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Docker",
      "type": "link",
      "icon": "docker",
      "url": "/d/docker-projects/docker-projects?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Services",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/services/services?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/postgres/postgresql?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/logs/logs?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Traces",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/traces/traces?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Alerts",
      "type": "link",
      "icon": "bolt",
      "url": "/d/alerts/alerts?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "App SLO",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/app-slo/app-slo?${__url_time_range}",
      "targetBlank": false
    },
    {
      "title": "Stack",
      "type": "link",
      "icon": "cloud",
      "url": "/d/self/self?${__url_time_range}",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Container (re)started",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (name) (time() - container_start_time_seconds{name!=\"\"} < 60)",
        "step": "60s",
        "titleFormat": "started: {{name}}"
      },
      {
        "name": "New image deployed",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "(count by (name, image) (container_last_seen{name!=\"\", image!=\"\"}) unless count by (name, image) (container_last_seen{name!=\"\", image!=\"\"} offset 10m)) and on (name) (time() - container_start_time_seconds{name!=\"\"} < 120)",
        "step": "60s",
        "titleFormat": "deploy: {{name}}",
        "textFormat": "{{image}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
